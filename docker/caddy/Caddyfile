{
    debug
    local_certs
}

:80 {
    # Notification service client channels: WebSocket + SSE subscriptions,
    # authenticated per-connection by JWT. These are the only notification
    # paths that legitimately need to be reachable from outside.
    handle /ws {
        reverse_proxy notification:8081
    }
    handle /sse {
        reverse_proxy notification:8081
    }
    handle /health {
        reverse_proxy notification:8081
    }

    # NOTE: the notification write endpoints (/api/v1/notifications/send,
    # /send-to-users, /broadcast, /channel, /channels) and the /stats and
    # /metrics paths are deliberately NOT proxied here. They are
    # server-to-server only: the Symfony backend reaches the notification
    # service directly over the Docker network (http://notification:8081,
    # with X-API-Key) after enforcing the notifications:manage permission.
    # Exposing them through Caddy would let external callers bypass that
    # authorization check and broadcast to any user.

    # Chat service (Rust microservice) - strips the /chat prefix so
    # /chat/ws -> chat:8082/ws and /chat/api/v1/... -> chat:8082/api/v1/...
    # (a distinct prefix avoids the /ws and /api/v1/* collisions above).
    handle_path /chat/* {
        reverse_proxy chat:8082
    }

    # Symfony PHP backend (default - handles all other routes including notification settings)
    handle {
        root * /app/public
        php_server
    }
}

https://ara.local {
