# Ara-infra Environment Configuration
# Copy this file to .env and customize the values

# ===========================================
# Application secret (Symfony)
# ===========================================
# REQUIRED: used to derive keys for CSRF, signed URLs and — critically —
# encryption of stored 2FA secrets. If empty, 2FA secrets are written to the
# database in PLAINTEXT, so the stack refuses to start without it.
# Generate a strong value with:  make gen-secret
APP_SECRET=change-this-to-a-secure-random-string

# ===========================================
# JWT Configuration (shared across services)
# ===========================================
# REQUIRED: the stack fails to start if this is unset (no insecure fallback).
# Generate a strong value with:  make gen-secret   (or: openssl rand -base64 48)
JWT_SECRET=change-this-to-a-secure-random-string-at-least-32-chars

# REQUIRED: passphrase protecting the RS256 private key. Must NOT be a shared
# or committed value — anyone who knows it can decrypt a leaked private key and
# forge tokens. Generate with 'make gen-secret'. If you change it you must
# regenerate the keypair (delete backend/config/jwt/*.pem, then 'make gen-jwt-keys').
JWT_PASSPHRASE=change-this-to-a-secure-random-string

# JWT issuer (optional)
JWT_ISSUER=ara-platform

# JWT audience (optional)
JWT_AUDIENCE=ara-services

# ===========================================
# Database Configuration
# ===========================================
# Backend (PHP/Symfony) database
POSTGRES_DB=symfony
POSTGRES_USER=symfony
POSTGRES_PASSWORD=symfony

# Chat service database (isolated from backend)
CHAT_POSTGRES_DB=ara_chat

# Symfony DSN — host MUST be the compose service name "postgres", not localhost.
DATABASE_URL="postgresql://symfony:symfony@postgres:5432/symfony?serverVersion=17&charset=utf8"

# ===========================================
# Redis URL (override for external Redis)
REDIS_URL=redis://redis:6379

# Application Mode
# ===========================================
APP_ENV=dev
APP_DEBUG=1

# ===========================================
# Notification Service
# ===========================================
# REQUIRED: shared secret between the backend and the notification service.
# The service enforces it (X-API-Key) on its send/broadcast/stats/metrics
# endpoints, and the backend sends it on every server-to-server call. Must be
# at least 16 characters. Generate with 'make gen-secret'.
NOTIFICATION_API_KEY=change-this-to-a-secure-random-string

# Log level: trace, debug, info, warn, error
RUST_LOG=info

# Enable features (set to true/false)
QUEUE_ENABLED=false
ACK_ENABLED=false
RATELIMIT_ENABLED=false
TENANT_ENABLED=false
CLUSTER_ENABLED=false

# ===========================================
# Backup Service Configuration
# ===========================================
# Retention period for local backups (days)
BACKUP_RETENTION_DAYS=7

# Cron schedule for automated backups (default: 2 AM daily)
BACKUP_SCHEDULE=0 2 * * *

# Run backup immediately on container start
BACKUP_ON_START=false

# Timezone for backup scheduling
TZ=UTC

# ===========================================
# S3 Backup Configuration (Optional)
# ===========================================
# Enable S3 backup upload
S3_BACKUP_ENABLED=false

# S3 bucket name for backups
S3_BACKUP_BUCKET=

# S3 key prefix for backup files
S3_BACKUP_PREFIX=backups

# AWS region (credentials do NOT go here — see docker-compose.s3.yml:
# they are supplied as a file-based Docker secret, or better, an IAM
# role when running on AWS)
AWS_DEFAULT_REGION=us-east-1
